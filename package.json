{
  "name": "node-asset-studio-mod",
  "version": "1.0.3",
  "description": "Controlled Node.js pipe API for linked AssetStudioMod libraries",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/build-bridge.js",
    "build:ts": "tsc",
    "setup:bridge": "node scripts/setup-bridge.js --force",
    "postinstall": "node scripts/setup-bridge.js",
    "prepack": "npm run build",
    "test": "npm run build:ts && node --test tests/*.test.mjs",
    "test:integration": "npm run build:ts && node --test tests/integration.mjs",
    "test:bridge": "node scripts/test-bridge.js",
    "pub": "pnpm publish"
  },
  "files": [
    "dist",
    "scripts/build-bridge.js",
    "scripts/dotnet.js",
    "scripts/export-assets.js",
    "scripts/setup-bridge.js",
    "bridge/Program.cs",
    "bridge/Options.cs",
    "bridge/DecodedTexture.cs",
    "bridge/SharedResourceReaders.cs",
    "bridge/vendor",
    "bridge/AssetStudioBridge.csproj",
    "bin/bridge",
    "readme.md",
    "readme_CN.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [],
  "author": "StarFreedomX",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
