{
  "name": "node-asset-studio-mod-js",
  "version": "0.1.4",
  "description": "Unity asset inspection and export in Node.js worker threads with JavaScript/WASM; no .NET runtime",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration.mjs",
    "pub": "npm publish",
    "test:package": "npm run build && node --test tests/package.mjs",
    "build:astc": "node scripts/build-astc.js"
  },
  "files": [
    "dist",
    "scripts/export-assets.js",
    "readme.md",
    "readme_CN.md",
    "THIRD_PARTY_NOTICES.md",
    "COMPATIBILITY.md",
    "WORKTREES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [],
  "author": "StarFreedomX",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "0.25.12",
    "spirv-tools": "20.4.1",
    "three": "0.180.0",
    "typescript": "5.9.3",
    "unityfs-js": "0.2.8"
  }
}
